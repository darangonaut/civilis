  "eras": {
    "settlement": {
      "name": "Settlement",
      "description": "Turn a handful of settlers into a self-sufficient village."
    },
    "antiquity": {
      "name": "Antiquity",
      "description": "Bricks, temples and aqueducts. The city grows up and out — fishermen work the water, villas need culture."
    },
    "middle_ages": {
      "name": "Middle Ages",
      "description": "Mining in the hills, smelters and universities. The crown of the city will be a cathedral."
    },
    "renaissance": {
      "name": "Renaissance",
      "description": "Trade, art and science. Sheep on pastures give cloth, harbors export it, and theaters and observatories make the city a center of learning."
    },
    "industrial": {
      "name": "Industrial Era",
      "description": "Steam, coal and steel. Factories and railways turn the city into an industrial power — crowned by the Exhibition Palace."
    },
    "modern": {
      "name": "Modern Era",
      "description": "Electricity changes everything: power plants, hospitals, department stores and the first skyscrapers."
    },
    "information": {
      "name": "Information Age",
      "description": "Computers, the internet and nuclear power. Electronics drive data centers, solar parks and vertical farms."
    },
    "future": {
      "name": "Near Future",
      "description": "Fusion, artificial intelligence and arcologies. The last step of civilization will be a spaceport."
    }
  },
